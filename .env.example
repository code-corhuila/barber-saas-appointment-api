# Names and placeholders only: never a real value. Copy to .env for local runs.
PORT=8080
# Empty DATABASE_URL: in-memory repository (no database needed to try the HTTP contract).
DATABASE_URL=jdbc:postgresql://localhost:5432/barbersaas
DATABASE_USER=appointment_app
DATABASE_PASSWORD=
# SPKI PEM public key, one line with \n escapes. barber-saas-infra-postgres/scripts/dev-keys.sh generates a development one.
JWT_PUBLIC_KEY=
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000
# The other domains' APIs (golden rule 8): price, duration and policy; free slots; the client's
# active reward coupon (DEC-APPT-09).
BARBERSHOP_API_URL=http://localhost:8081
SCHEDULE_API_URL=http://localhost:8082
LOYALTY_API_URL=http://localhost:8084
